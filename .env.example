# ==========================================
# OwnLog Environment Variables
# ==========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control (already in .gitignore)
# ==========================================

# Google OAuth Client ID for Google Drive backup functionality
# Get this from: https://console.cloud.google.com/apis/credentials
# Must be a "Web application" or "Android" OAuth 2.0 Client ID
# Format: xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Sentry DSN for error monitoring (optional)
# Get this from: https://sentry.io/settings/ownlog/keys/
# Leave empty if you don't want to use Sentry
SENTRY_DSN=your_sentry_dsn_here
